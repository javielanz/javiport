---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  ogImage?: string;
}

const { title, description = '', lang = 'es', ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resolvedOgImage = ogImage ?? new URL(`${basePath}og.png`, Astro.site).href;
const otherLang = lang === 'es' ? 'en' : 'es';
const otherPath = Astro.url.pathname.replace(/^\/javiport\/(es|en)\//, `/javiport/${otherLang}/`);
const otherHref = new URL(otherPath, Astro.site);
const xDefaultPath = Astro.url.pathname.replace(/^\/javiport\/(es|en)\//, '/javiport/');
const xDefaultHref = new URL(xDefaultPath, Astro.site);
---
<!DOCTYPE html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={otherLang} href={otherHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta name="theme-color" content="#0A0908" />
    <meta name="color-scheme" content="dark" />

    <!-- OG / Twitter -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={lang === 'es' ? 'es_VE' : 'en_US'} />
    <meta property="og:locale:alternate" content={otherLang === 'es' ? 'es_VE' : 'en_US'} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Fonts: Google Fonts variable fonts (self-host in M10) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Skip link -->
    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 1rem;
        background: var(--color-accent);
        color: #000;
        padding: 0.5rem 1rem;
        z-index: 9999;
        font-size: 0.875rem;
        transition: top 150ms;
      }
      .skip-link:focus { top: 1rem; }
    </style>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>
    <slot />
    <!-- GoatCounter — cookieless analytics; site code must exist at goatcounter.com -->
    <script
      is:inline
      data-goatcounter="https://javielanz.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </body>
</html>
