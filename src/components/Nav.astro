---
interface Props {
  lang: 'en' | 'es';
  currentPath?: string;
}

const { lang } = Astro.props;

const navLinks = {
  en: [
    { label: 'About',        href: '#about' },
    { label: 'Work',         href: '#work' },
    { label: 'Capabilities', href: '#capabilities' },
    { label: 'Experience',   href: '#experience' },
    { label: 'Education',    href: '#education' },
    { label: 'Contact',      href: '#contact' },
  ],
  es: [
    { label: 'Sobre Mí',    href: '#about' },
    { label: 'Proyectos',   href: '#work' },
    { label: 'Capacidades', href: '#capabilities' },
    { label: 'Experiencia', href: '#experience' },
    { label: 'Educación',   href: '#education' },
    { label: 'Contacto',    href: '#contact' },
  ],
};

const links = navLinks[lang];
const otherLang = lang === 'es' ? 'en' : 'es';
const otherLabel = lang === 'es' ? 'EN' : 'ES';
const toggleAriaLabel = lang === 'es' ? 'Switch to English' : 'Cambiar a inglés';
---

<header
  id="main-nav"
  class="fixed top-0 w-full z-50 border-b hidden md:block"
  transition:persist
>
  <div
    class="flex justify-between items-center w-full px-5 py-6 mx-auto"
    style="max-width: min(1440px, 92vw);"
  >
    <a
      href={`/javiport/${lang}/`}
      class="font-display text-xl uppercase tracking-tighter"
      style="color: var(--color-text);"
    >
      Javier Lanz
    </a>

    <nav aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
      <ul class="flex gap-8 list-none m-0 p-0">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-mono text-xs tracking-widest uppercase transition-colors duration-300"
              style="color: var(--color-text-muted);"
              onmouseover="this.style.color='var(--color-accent)'"
              onmouseout="this.style.color='var(--color-text-muted)'"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="lang-toggle"
      class="font-mono text-xs tracking-widest uppercase transition-colors duration-300 cursor-pointer border-0 bg-transparent"
      style="color: var(--color-text-muted);"
      aria-label={toggleAriaLabel}
      data-other-lang={otherLang}
    >
      {otherLabel}
    </button>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const hero = document.getElementById('hero');

  if (nav && hero) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > hero.offsetHeight - 100) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    }, { passive: true });
  }

  const toggle = document.getElementById('lang-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const otherLang = toggle.dataset.otherLang as string;
      localStorage.setItem('lang', otherLang);
      const current = window.location.pathname;
      const next = current.replace(/\/(es|en)\//, `/${otherLang}/`);
      window.location.href = next;
    });
  }
</script>
