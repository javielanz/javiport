---
import MediaFrame from './MediaFrame.astro';
import Reveal from './Reveal.astro';
import type { Lang } from '../lib/strings';

interface NavEntry {
  slug: string;
  title: string;
}

interface Props {
  lang: Lang;
  title: string;
  tag: string;
  summary: string;
  year: number;
  role: string;
  tags: string[];
  cover?: string;
  coverAlt?: string;
  prev?: NavEntry;
  next?: NavEntry;
}

const {
  lang,
  title,
  tag,
  summary,
  year,
  role,
  tags,
  cover,
  coverAlt,
  prev,
  next,
} = Astro.props;

const prevLabel = lang === 'es' ? 'Anterior' : 'Previous';
const nextLabel = lang === 'es' ? 'Siguiente' : 'Next';
const backLabel = lang === 'es' ? '← Volver a inicio' : '← Back to home';
const homeHref = `/javiport/${lang}/#work`;
const workHref = (slug: string) => `/javiport/${lang}/work/${slug}/`;
---

<article class="case-study">
  {cover && coverAlt && (
    <header class="case-study-hero">
      <MediaFrame
        src={cover}
        alt={coverAlt}
        widths={[480, 960, 1440]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        pictureClass="case-study-cover-picture"
      />
      <div
        class="case-study-cover-scrim"
        aria-hidden="true"
      ></div>
    </header>
  )}

  <div class="mx-auto px-5" style="max-width: min(1440px, 92vw);">
    <Reveal type="fade">
      <a
        href={homeHref}
        class="font-mono text-xs tracking-widest uppercase inline-block mt-12"
        style="color: var(--color-text-muted);"
      >
        {backLabel}
      </a>
    </Reveal>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mt-12">
      <div class="md:col-span-8">
        <Reveal type="fade">
          <div
            class="font-mono text-xs tracking-widest uppercase mb-6"
            style="color: var(--color-accent);"
          >
            {tag}
          </div>
        </Reveal>

        <Reveal type="mask">
          <h1
            class="font-display"
            style="font-size: var(--text-display-xl); line-height: 1.05; color: var(--color-text); margin-bottom: 1.5rem;"
          >
            {title}
          </h1>
        </Reveal>

        <Reveal type="fade" delay={120}>
          <p
            class="mb-12"
            style="font-size: var(--text-body-lg); color: var(--color-text-muted); line-height: 1.6;"
          >
            {summary}
          </p>
        </Reveal>
      </div>

      <aside class="md:col-span-4 md:pt-20">
        <Reveal type="fade" delay={160}>
          <dl class="grid gap-4">
            <div>
              <dt class="font-mono text-xs tracking-widest uppercase" style="color: var(--color-text-subtle);">
                {lang === 'es' ? 'Año' : 'Year'}
              </dt>
              <dd style="color: var(--color-text);">{year}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs tracking-widest uppercase" style="color: var(--color-text-subtle);">
                {lang === 'es' ? 'Rol' : 'Role'}
              </dt>
              <dd style="color: var(--color-text);">{role}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs tracking-widest uppercase" style="color: var(--color-text-subtle);">
                {lang === 'es' ? 'Tags' : 'Tags'}
              </dt>
              <dd class="flex flex-wrap gap-2 mt-1">
                {tags.map((t) => (
                  <span
                    class="font-mono text-xs tracking-widest uppercase px-2 py-1 border"
                    style="color: var(--color-text-muted); border-color: var(--color-line);"
                  >
                    {t}
                  </span>
                ))}
              </dd>
            </div>
          </dl>
        </Reveal>
      </aside>
    </div>

    <div class="case-study-body mt-12">
      <Reveal type="fade">
        <slot />
      </Reveal>
    </div>

    {(prev || next) && (
      <nav
        class="mt-24 pt-12 border-t grid grid-cols-1 md:grid-cols-2 gap-8"
        style="border-color: var(--color-line);"
        aria-label={lang === 'es' ? 'Más trabajo' : 'More work'}
      >
        <div>
          {prev && (
            <a href={workHref(prev.slug)} class="block group">
              <div class="font-mono text-xs tracking-widest uppercase mb-2" style="color: var(--color-text-subtle);">← {prevLabel}</div>
              <div
                class="font-display group-hover:text-[var(--color-accent)] transition-colors"
                style="font-size: var(--text-display-md); color: var(--color-text);"
              >
                {prev.title}
              </div>
            </a>
          )}
        </div>
        <div class="md:text-right">
          {next && (
            <a href={workHref(next.slug)} class="block group">
              <div class="font-mono text-xs tracking-widest uppercase mb-2" style="color: var(--color-text-subtle);">{nextLabel} →</div>
              <div
                class="font-display group-hover:text-[var(--color-accent)] transition-colors"
                style="font-size: var(--text-display-md); color: var(--color-text);"
              >
                {next.title}
              </div>
            </a>
          )}
        </div>
      </nav>
    )}
  </div>
</article>

<style is:global>
  .case-study-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 90vh;
    overflow: hidden;
    view-transition-name: case-study-cover;
  }
  .case-study-cover-picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .case-study-cover-picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case-study-cover-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 8, 0) 0%,
      rgba(10, 9, 8, 0) 60%,
      rgba(10, 9, 8, 0.85) 100%
    );
    pointer-events: none;
  }
  .case-study-body p {
    max-width: min(680px, 92vw);
    font-size: var(--text-body-lg);
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .case-study-body h2 {
    font-family: var(--font-display);
    font-size: var(--text-display-md);
    color: var(--color-text);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .case-study-body ul {
    max-width: min(680px, 92vw);
    margin-bottom: 1.5rem;
  }
  .case-study-body blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.5rem;
    margin: 2.5rem 0;
    font-family: var(--font-display);
    font-size: var(--text-display-md);
    line-height: 1.3;
    color: var(--color-text);
  }
  .case-study-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 4rem;
  }
  @media (min-width: 768px) {
    .case-study-gallery {
      grid-template-columns: 1fr 1fr;
    }
    .case-study-gallery > :first-child {
      grid-column: 1 / -1;
    }
  }
  .case-study-gallery picture {
    display: block;
    width: 100%;
  }
  .case-study-gallery picture img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
