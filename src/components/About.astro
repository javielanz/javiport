---
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

const strings = {
  en: {
    eyebrow: 'ABOUT',
    headline: 'Strategy at 24 frames per second.',
    p1: "I'm a Communication Social student at Universidad Monteávila and Content Strategist at EGCars, where I'm helping launch Suzuki in Venezuela. My work sits at the intersection of cinema, brand, and emerging AI tooling — I treat content strategy the way a director treats a film: every frame earns its place.",
    p2: "When I'm not writing campaigns, I'm directing music videos, shooting street-journalism in Caracas, or analyzing how franchises like Nolan's build loyal audiences.",
    fact: 'B.A. Communication Social · GPA 17.00 / 20.00 · Cambridge B2',
  },
  es: {
    eyebrow: 'SOBRE MÍ',
    headline: 'Estrategia a 24 cuadros por segundo.',
    p1: 'Soy estudiante de Comunicación Social en la Universidad Monteávila y Content Strategist en EGCars, donde estoy ayudando a lanzar Suzuki en Venezuela. Mi trabajo vive en la intersección entre cine, marca y nuevas herramientas de IA — entiendo la estrategia de contenido como un director entiende una película: cada plano se gana su lugar.',
    p2: "Cuando no estoy escribiendo campañas, dirijo videoclips, hago periodismo de calle en Caracas, o analizo cómo franquicias como las de Nolan construyen audiencias leales.",
    fact: 'Lic. Comunicación Social · Índice 17.00 / 20.00 · Cambridge B2',
  },
};

const t = strings[lang];
---

<section
  id="about"
  class="px-5 mx-auto"
  style="padding-top: clamp(6rem,12vw,12rem); padding-bottom: clamp(6rem,12vw,12rem); max-width: min(1440px, 92vw);"
>
  <div style="max-width: min(680px, 92vw);">
    <SectionHeader eyebrow={t.eyebrow} headline={t.headline} />

    <p
      class="scroll-reveal-fade"
      style="font-size: var(--text-body-lg); color: var(--color-text-muted); line-height: 1.7; margin-top: 2rem; transition-delay: 100ms;"
    >
      {t.p1}
    </p>

    <p
      class="scroll-reveal-fade"
      style="font-size: var(--text-body-lg); color: var(--color-text-muted); line-height: 1.7; margin-top: 1.5rem; transition-delay: 200ms;"
    >
      {t.p2}
    </p>

    <p
      class="scroll-reveal-fade font-mono uppercase tracking-widest"
      style="font-size: var(--text-eyebrow); color: var(--color-text-subtle); margin-top: 2rem; transition-delay: 300ms;"
    >
      {t.fact}
    </p>
  </div>
</section>
