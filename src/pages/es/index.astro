---
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Footer from '../../components/Footer.astro';

const lang = 'es' as const;
---

<Layout
  title="Javier Lanz — Estratega de Contenido y Narrador"
  description="Estudiante de Comunicación Social y Content Strategist en EGCars / Suzuki Venezuela. Trabajo seleccionado en estrategia de marca, fotografía, periodismo y cine."
  lang={lang}
>
  <Nav lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <About lang={lang} />
    <!-- M7: Work, Capabilities, Experience, Education, Contact sections -->
  </main>
  <Footer lang={lang} />
</Layout>
