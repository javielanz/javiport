---
import { getCollection, render } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import Reveal from './Reveal.astro';
import { getStrings, type Lang } from '../lib/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getStrings(lang).experience;

const entries = (await getCollection('experience', (e) => e.data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<section
  id="experience"
  class="w-full"
  style="padding: clamp(6rem,12vw,12rem) 0;"
>
  <div class="mx-auto px-5" style="max-width: min(1440px, 92vw);">
    <Reveal type="fade">
      <SectionHeader eyebrow={t.eyebrow} headline={t.headline} />
    </Reveal>

    <ol class="mt-16 list-none p-0 m-0 grid gap-12">
      {rendered.map(({ entry, Content }, i) => (
        <Reveal type="fade" tag="li" delay={i * 80}>
          <article
            class="grid grid-cols-1 md:grid-cols-12 gap-6 pb-12 border-b"
            style="border-color: var(--color-line);"
          >
            <div class="md:col-span-3">
              <div
                class="font-mono text-xs tracking-widest uppercase"
                style="color: var(--color-text-subtle);"
              >
                {entry.data.dates}
              </div>
            </div>
            <div class="md:col-span-9">
              <h3
                class="font-display mb-1"
                style="font-size: var(--text-display-md); line-height: 1.2; color: var(--color-text);"
              >
                {entry.data.title}
              </h3>
              <div
                class="font-mono text-xs tracking-widest uppercase mb-6"
                style="color: var(--color-accent);"
              >
                {entry.data.role}
              </div>
              <div
                class="prose-experience"
                style="color: var(--color-text-muted); font-size: var(--text-body); line-height: 1.7;"
              >
                <Content />
              </div>
            </div>
          </article>
        </Reveal>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .prose-experience ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .prose-experience li {
    padding-left: 1.25rem;
    position: relative;
  }
  .prose-experience li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-accent);
  }
  .prose-experience p + ul,
  .prose-experience ul + p {
    margin-top: 1rem;
  }
</style>
