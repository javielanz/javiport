---
import SectionHeader from './SectionHeader.astro';
import { getStrings, type Lang } from '../lib/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getStrings(lang).about;
---

<section
  id="about"
  class="px-5 mx-auto"
  style="padding-top: clamp(6rem,12vw,12rem); padding-bottom: clamp(6rem,12vw,12rem); max-width: min(1440px, 92vw);"
>
  <div style="max-width: min(680px, 92vw);">
    <SectionHeader eyebrow={t.eyebrow} headline={t.headline} />

    <p
      class="scroll-reveal-fade"
      style="font-size: var(--text-body-lg); color: var(--color-text-muted); line-height: 1.7; margin-top: 2rem; transition-delay: 100ms;"
    >
      {t.p1}
    </p>

    <p
      class="scroll-reveal-fade"
      style="font-size: var(--text-body-lg); color: var(--color-text-muted); line-height: 1.7; margin-top: 1.5rem; transition-delay: 200ms;"
    >
      {t.p2}
    </p>

    <p
      class="scroll-reveal-fade font-mono uppercase tracking-widest"
      style="font-size: var(--text-eyebrow); color: var(--color-text-subtle); margin-top: 2rem; transition-delay: 300ms;"
    >
      {t.fact}
    </p>
  </div>
</section>
