---
import { getStrings, type Lang } from '../lib/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getStrings(lang).footer;
const otherLang = lang === 'es' ? 'en' : 'es';
---

<footer
  class="w-full border-t scroll-reveal-fade"
  style="border-color: var(--color-line); background: var(--color-bg); padding: clamp(3rem,6vw,6rem) 0;"
>
  <div
    class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end px-5 mx-auto"
    style="max-width: min(1440px, 92vw);"
  >
    <div class="md:col-span-6">
      <div class="font-display mb-2" style="font-size: 1.5rem; color: var(--color-text);">
        Javier Lanz
      </div>
      <div style="font-size: var(--text-caption); color: var(--color-text-muted);">
        {t.credit}
      </div>
    </div>

    <div class="md:col-span-6 flex gap-6 md:justify-end mt-6 md:mt-0">
      <a
        href={`/javiport/${otherLang}/`}
        class="font-mono text-xs tracking-widest uppercase transition-colors duration-300"
        style="color: var(--color-text-muted);"
        onclick={`localStorage.setItem('lang','${otherLang}')`}
      >
        {t.langSwitch}
      </a>
      <a
        href="https://github.com/javielanz"
        class="font-mono text-xs tracking-widest uppercase transition-colors duration-300"
        style="color: var(--color-text-muted);"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub<span class="sr-only"> (opens in new tab)</span>
      </a>
      <button
        onclick="window.scrollTo({top:0,behavior:'smooth'})"
        class="font-mono text-xs tracking-widest uppercase transition-colors duration-300 border-0 bg-transparent cursor-pointer"
        style="color: var(--color-text-muted);"
      >
        {t.backToTop}
      </button>
    </div>
  </div>

  <div class="px-5 mt-8 mx-auto" style="max-width: min(1440px, 92vw);">
    <p style="font-size: var(--text-caption); color: var(--color-text-subtle);">
      {t.techCredit}
    </p>
  </div>
</footer>
