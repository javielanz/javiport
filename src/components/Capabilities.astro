---
import SectionHeader from './SectionHeader.astro';
import Reveal from './Reveal.astro';
import { getStrings, type Lang } from '../lib/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getStrings(lang).capabilities;
---

<section
  id="capabilities"
  class="w-full border-t"
  style="padding: clamp(6rem,12vw,12rem) 0; border-color: var(--color-line); background: var(--color-bg-elev);"
>
  <div class="mx-auto px-5" style="max-width: min(1440px, 92vw);">
    <Reveal type="fade">
      <SectionHeader eyebrow={t.eyebrow} headline={t.headline} />
    </Reveal>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-14 mt-16">
      {t.clusters.map((cluster, i) => (
        <Reveal type="fade" delay={i * 100}>
          <div>
            <h3
              class="font-mono text-xs tracking-widest uppercase mb-4"
              style="color: var(--color-accent);"
            >
              {cluster.label}
            </h3>
            <p
              class="font-display"
              style="font-size: var(--text-display-md); line-height: 1.35; color: var(--color-text);"
            >
              {cluster.skills}
            </p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
