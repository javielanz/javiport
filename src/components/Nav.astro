---
interface Props {
  lang: 'en' | 'es';
  variant?: 'home' | 'case';
  currentPath?: string;
}

const { lang, variant = 'home' } = Astro.props;
const isCase = variant === 'case';

const navLinks = {
  en: [
    { label: 'About',        href: '#about' },
    { label: 'Work',         href: '#work' },
    { label: 'Capabilities', href: '#capabilities' },
    { label: 'Experience',   href: '#experience' },
    { label: 'Education',    href: '#education' },
    { label: 'Contact',      href: '#contact' },
  ],
  es: [
    { label: 'Sobre Mí',    href: '#about' },
    { label: 'Proyectos',   href: '#work' },
    { label: 'Capacidades', href: '#capabilities' },
    { label: 'Experiencia', href: '#experience' },
    { label: 'Educación',   href: '#education' },
    { label: 'Contacto',    href: '#contact' },
  ],
};

const links = navLinks[lang];
const otherLang = lang === 'es' ? 'en' : 'es';
const otherLabel = lang === 'es' ? 'EN' : 'ES';
const toggleAriaLabel = lang === 'es' ? 'Switch to English' : 'Cambiar a inglés';
const menuLabel = lang === 'es' ? 'Menú' : 'Menu';
const closeLabel = lang === 'es' ? 'Cerrar menú' : 'Close menu';
const backLabel = lang === 'es' ? '← Volver a inicio' : '← Back to home';
const backLabelShort = lang === 'es' ? '← Inicio' : '← Home';
const backHref = `/javiport/${lang}/#work`;
---

<header
  id="main-nav"
  class:list={['fixed top-0 w-full z-50 border-b', isCase && 'scrolled']}
  transition:persist={isCase ? 'nav-case' : 'nav-home'}
>
  {!isCase && (
    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-hidden="true" tabindex="-1" />
  )}

  <div
    class="flex justify-between items-center w-full px-5 py-6 mx-auto"
    style="max-width: min(1440px, 92vw);"
  >
    <a
      href={`/javiport/${lang}/`}
      class="font-display text-xl uppercase tracking-tighter"
      style="color: var(--color-text);"
    >
      Javier Lanz
    </a>

    {!isCase && (
      <nav
        class="hidden md:block"
        aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}
      >
        <ul class="flex gap-8 list-none m-0 p-0">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link font-mono text-xs tracking-widest uppercase transition-colors duration-300"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="flex items-center gap-6">
      {isCase && (
        <a
          href={backHref}
          class="nav-link font-mono text-xs tracking-widest uppercase transition-colors duration-300 whitespace-nowrap"
        >
          <span class="hidden sm:inline">{backLabel}</span>
          <span class="sm:hidden">{backLabelShort}</span>
        </a>
      )}

      <button
        id="lang-toggle"
        class="font-mono text-xs tracking-widest uppercase transition-colors duration-300 cursor-pointer border-0 bg-transparent"
        style="color: var(--color-text-muted);"
        aria-label={toggleAriaLabel}
        data-other-lang={otherLang}
      >
        {otherLabel}
      </button>

      {!isCase && (
        <label
          for="nav-toggle"
          class="nav-burger md:hidden"
          aria-label={menuLabel}
          role="button"
          tabindex="0"
        >
          <span class="nav-burger-bar"></span>
          <span class="nav-burger-bar"></span>
          <span class="nav-burger-bar"></span>
        </label>
      )}
    </div>
  </div>

  {!isCase && (
    <div class="nav-drawer md:hidden" id="nav-drawer">
      <nav aria-label={lang === 'es' ? 'Navegación móvil' : 'Mobile navigation'}>
        <ul class="flex flex-col gap-6 list-none m-0 p-0 px-8 py-12">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-drawer-link font-display text-3xl"
                data-nav-close
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}

  {!isCase && (
    <label
      for="nav-toggle"
      class="nav-scrim md:hidden"
      aria-label={closeLabel}
      tabindex="-1"
    ></label>
  )}
</header>

<style>
  .nav-toggle-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  .nav-link {
    color: var(--color-text-muted);
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-accent);
  }

  .nav-burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1.5rem;
    height: 1rem;
    cursor: pointer;
    background: transparent;
    border: 0;
  }
  /* Tailwind's md:hidden lives in a cascade layer and loses to this component's
     unlayered display rules — hide the mobile-only chrome here instead. */
  @media (min-width: 768px) {
    .nav-burger,
    .nav-drawer,
    .nav-scrim {
      display: none;
    }
  }
  .nav-burger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .nav-burger-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-text);
    transition: transform 250ms ease, opacity 200ms ease;
    transform-origin: center;
  }

  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100dvh;
    width: min(86vw, 360px);
    background: var(--color-bg-elev);
    transform: translateX(100%);
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 60;
    padding-top: 5rem;
    border-left: 1px solid var(--color-line);
    overflow-y: auto;
  }

  .nav-drawer-link {
    color: var(--color-text);
    text-decoration: none;
    display: block;
    transition: color 200ms ease;
  }
  .nav-drawer-link:hover,
  .nav-drawer-link:focus-visible {
    color: var(--color-accent);
  }

  .nav-scrim {
    position: fixed;
    inset: 0;
    background: rgba(10, 9, 8, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms ease;
    z-index: 55;
  }

  .nav-toggle-input:checked ~ .nav-drawer {
    transform: translateX(0);
  }
  .nav-toggle-input:checked ~ .nav-scrim {
    opacity: 1;
    pointer-events: auto;
  }
  .nav-toggle-input:checked ~ div .nav-burger .nav-burger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle-input:checked ~ div .nav-burger .nav-burger-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle-input:checked ~ div .nav-burger .nav-burger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer,
    .nav-scrim,
    .nav-burger-bar {
      transition: none;
    }
  }
</style>

<script>
  // All handlers are document-level delegation registered once, so they keep
  // working across ClientRouter swaps regardless of which nav variant renders.
  window.addEventListener(
    'scroll',
    () => {
      const nav = document.getElementById('main-nav');
      if (!nav) return;
      const hero = document.getElementById('hero');
      if (!hero) return; // case variant is statically solid
      nav.classList.toggle('scrolled', window.scrollY > hero.offsetHeight - 100);
    },
    { passive: true }
  );

  document.addEventListener('click', (e) => {
    const target = e.target as Element;

    const toggle = target.closest('#lang-toggle') as HTMLElement | null;
    if (toggle) {
      const otherLang = toggle.dataset.otherLang as string;
      localStorage.setItem('lang', otherLang);
      window.location.href = window.location.pathname.replace(/\/(es|en)\//, `/${otherLang}/`);
      return;
    }

    if (target.closest('[data-nav-close]')) {
      const checkbox = document.getElementById('nav-toggle') as HTMLInputElement | null;
      if (checkbox) checkbox.checked = false;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const checkbox = document.getElementById('nav-toggle') as HTMLInputElement | null;
    if (checkbox?.checked) checkbox.checked = false;
  });
</script>
